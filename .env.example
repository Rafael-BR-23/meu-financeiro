# Configurações do Aplicativo Flask
SECRET_KEY=
APP_ENV=development
TRUSTED_PROXY=
TRUSTED_PROXY_NETWORKS=
ENABLE_HSTS=0
FLASK_DEBUG=0
PORT=5000

# Supabase Auth: ative após preencher URL/chave e configurar Google/redirects no painel.
AUTH_PROVIDER=local
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_GOOGLE_ENABLED=1
SUPABASE_TOKEN_ENCRYPTION_KEY=
# Compose fornece Redis interno. Em execução direta, configure um backend compartilhado em produção.
RATELIMIT_STORAGE_URI=redis://redis:6379/0

# OAuth Google: cliente do tipo Aplicativo da Web
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# URL exata cadastrada no Google, ex.: https://financas.exemplo.com/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
# Use 1 em produção com HTTPS; 0 apenas para desenvolvimento HTTP local.
SESSION_COOKIE_SECURE=0

# Envio de recuperação de senha (SMTP com STARTTLS na porta 587 ou SSL na 465)
APP_PUBLIC_URL=http://localhost:5000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=0

# Credenciais de Deploy ZimaOS (SSH)
ZIMAOS_HOST=servidor.exemplo.com
ZIMAOS_KNOWN_HOSTS=C:/Users/usuario/.ssh/known_hosts
ZIMAOS_USER=usuario
ZIMAOS_PASS=
ZIMAOS_DIR=/DATA/AppData/Financeiro
